{
    "name": "konventix/compliance",
    "description": "Konventix Compliance module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\Compliance\\": "src/",
            "Konventix\\Compliance\\Tests\\": "tests/",
            "Konventix\\Compliance\\Database\\Factories\\": "database/factories/",
            "Konventix\\Compliance\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Konventix\\Compliance\\Providers\\ComplianceServiceProvider"
            ]
        }
    }
}
