{
    "name": "konventix/newsletter",
    "description": "Konventix Newsletter module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\Newsletter\\": "src/",
