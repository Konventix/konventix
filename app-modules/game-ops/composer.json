{
    "name": "konventix/game-ops",
    "description": "Konventix GameOps module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\GameOps\\": "src/",
            "Konventix\\GameOps\\Tests\\": "tests/",
            "Konventix\\GameOps\\Database\\Factories\\": "database/factories/",
            "Konventix\\GameOps\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Konventix\\GameOps\\Providers\\GameOpsServiceProvider"
            ]
        }
    }
}
