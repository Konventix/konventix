{
    "name": "konventix/competition",
    "description": "Konventix Competition module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\Competition\\": "src/",
            "Konventix\\Competition\\Tests\\": "tests/",
            "Konventix\\Competition\\Database\\Factories\\": "database/factories/",
            "Konventix\\Competition\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
