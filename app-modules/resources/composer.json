{
    "name": "konventix/resources",
    "description": "Konventix Resources module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\Resources\\": "src/",
            "Konventix\\Resources\\Tests\\": "tests/",
            "Konventix\\Resources\\Database\\Factories\\": "database/factories/",
            "Konventix\\Resources\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Konventix\\Resources\\Providers\\ResourcesServiceProvider"
            ]
        }
    }
}
