{
    "name": "konventix/event",
    "description": "Konventix Event module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\Event\\": "src/",
            "Konventix\\Event\\Tests\\": "tests/",
            "Konventix\\Event\\Database\\Factories\\": "database/factories/",
            "Konventix\\Event\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Konventix\\Event\\Providers\\EventServiceProvider"
            ]
        }
    }
}
