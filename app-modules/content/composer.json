{
    "name": "konventix/content",
    "description": "Konventix Content module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\Content\\": "src/",
            "Konventix\\Content\\Tests\\": "tests/",
            "Konventix\\Content\\Database\\Factories\\": "database/factories/",
            "Konventix\\Content\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Konventix\\Content\\Providers\\ContentServiceProvider"
            ]
        }
    }
}
