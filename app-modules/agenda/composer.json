{
    "name": "konventix/agenda",
    "description": "Konventix Agenda module.",
    "type": "library",
    "version": "1.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "konventix/platform": "*"
    },
    "autoload": {
        "psr-4": {
            "Konventix\\Agenda\\": "src/",
