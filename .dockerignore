.git
.github
.env
.env.*
!/.env.example
node_modules
vendor
frankenphp
data
config/caddy/autosave.json
# Stripe CLI state on a developer's machine (#257); it is not configuration
# this application reads, and it arrives as a 0700 directory the runtime user
# cannot enter.
config/stripe
storage/app/*
!storage/app/.gitignore
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
# 174 MB of Inertia devtools cache on a developer's machine (#257). It never
# existed in CI's fresh clone, so it never showed up in a pipeline-built image —
# but a local `docker build` shipped it, and `chown -R … storage` then copied
# every byte of it up into a second layer.
storage/inertia-devtools
bootstrap/cache/*.php
public/build
public/storage
bootstrap/ssr
resources/js/routes
resources/js/actions
docs
.superpowers
.ai
boost.json
CLAUDE.md
CLAUDE_extra.md
compose.yaml

# The rest of #257's list. `COPY . .` put every one of these into the release
# artifact; none of them is read at runtime, and the first two carry dev
# credentials that a secret scanner will keep finding for as long as they ship:
# contrib/garage.toml's rpc_secret and admin_token, contrib/prod-local.env's
# DB_PASSWORD, compose.prod-local.yaml's POSTGRES_PASSWORD and
# KONVENTIX_ADMIN_PASSWORD. Nothing here is served over HTTP — Caddy's root is
# `public/` — so this is disclosure to whoever can read the image, not a
# reachable hole.
#
# `database/` deliberately stays in: the migrate role runs the migrations out of
# the image. `stubs/` goes: config/app-modules.php names those paths, but only
# `make:module` ever opens one, and that is a development command.
contrib
compose.prod-local.yaml
tests
phpunit.xml
.gitlab-ci.yml
.claude
.mcp.json
stubs
pint.json
phpstan.neon
eslint.config.js
vitest.config.ts
