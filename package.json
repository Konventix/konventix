{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "konventix",
    "description": "Frontend for Konventix \u2014 event-agnostic event management platform.",
    "author": "Markus Kohn <post@markus-kohn.com>",
    "license": "AGPL-3.0-or-later",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/ \"app-modules/*/resources/**/*.{ts,tsx,vue,js,css,json}\"",
        "format:check": "prettier --check resources/ \"app-modules/*/resources/**/*.{ts,tsx,vue,js,css,json}\"",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --noEmit",
        "test:js": "vitest run",
        "observability:build": "node contrib/observability/src/build.mjs",
        "observability:check": "node contrib/observability/src/build.mjs --check"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "chokidar": "^5.0.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "fontaine": "^0.8.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/echo-vue": "^2.4.0",
        "@lucide/vue": "^1.17.0",
        "@noble/curves": "^2.3.0",
        "@tanstack/vue-table": "^8.21.3",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.0.0",
        "laravel-vue-i18n": "^2.9.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-sonner": "^2.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
