<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <groups>
        <exclude>
            <!-- tests/Load/RushResultTest.php reads the results of a real k6
                 run against the live dev stack (ADR-0047 point 6): it has no
                 place in an ordinary suite run, which never boots a server
                 for it to have hit. Run it explicitly, naming the load
                 group and the file. -->
            <group>load</group>
        </exclude>
    </groups>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Feature tests per module live in the module's own tests/ directory. -->
        <testsuite name="Modules">
            <directory>app-modules/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>app-modules</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- The array transport delivers nothing, and the suite asserts subjects
             verbatim; the guard itself is exercised by NonProductionMailGuardTest. -->
        <env name="MAIL_ALLOWLIST" value="*"/>
        <env name="MAIL_TAG_SUBJECTS" value="false"/>
        <!--
            The suite runs against the local-disk deployment, whatever backend
            the developer's .env picks. Tests assert the fallback disk by name
            ("media", not "media_s3"), and ADR-0043's S3 paths are covered by
            tests that build their own S3 disk — so inheriting MEDIA_DISK from
            .env would make a green suite depend on who ran it.
        -->
        <env name="MEDIA_DISK" value="media"/>
        <env name="INVOICES_DISK" value="invoices"/>
        <env name="EXPORTS_DISK" value="exports"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- ArrayWaitingRoomStore, not Redis (ADR-0047 point 5) — a test
             process needs no real queue infrastructure. -->
        <env name="WAITING_ROOM_STORE" value="array"/>
        <!-- The suite must never depend on the developer's own .env carrying
             (or not carrying) a live key: StripeApi's container binding
             throws when this is empty (CommerceServiceProvider), and every
             test that needs a Stripe webhook secret sets it explicitly via
             config() rather than relying on this default — see
             StripeWebhookTest and WebhookThrottleTest. -->
        <env name="STRIPE_SECRET" value=""/>
        <env name="STRIPE_WEBHOOK_SECRET" value=""/>
        <env name="PROMETHEUS_STORAGE" value="memory"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="DEBUGBAR_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
