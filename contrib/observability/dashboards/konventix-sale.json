{
  "uid": "konventix-sale",
  "title": "Konventix Sale",
  "description": "Orders, payments, webhooks, the waiting room and seating, per brand. Source: konventix-poc contrib/observability (ADR-0059).",
  "tags": [
    "konventix",
    "sale"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
