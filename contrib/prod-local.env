# Runtime environment for compose.prod-local.yaml — the production image run
# locally for the k6 rush. Read that file's header first; the two departures
# from a real deployment (APP_ENV and the Sail-image seeder) are explained
# there, not here.
#
# This is a load-test rig on a laptop. The credentials below are fixed on
# purpose so a run is reproducible, and are worthless outside it: nothing in
# this file is a secret, and nothing here belongs in a deployment. The chart
# supplies its own (ADR-0049 §12 — APP_KEY is the deployment's custody).

APP_NAME=Konventix
# Not `production`: LocalHostedCheckoutAdapter is registered for the null
# provider only outside it, and without a hosted checkout the rush cannot
# complete a cart. See compose.prod-local.yaml's header.
APP_ENV=local
APP_KEY=base64:P1QIXgwnRIUk670wMUUkG+W9zXMP5XNU2ehk/JoOds0=
APP_DEBUG=false
APP_URL=http://rush.localhost:8000
APP_MAINTENANCE_DRIVER=file

# stderr so `docker compose logs` is the whole story, and `warning` so 1,000
# arrivals do not turn the run into a disk-IO benchmark.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=konventix
DB_USERNAME=konventix
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

# ADR-0047 point 6: sessions, cache, queue and the waiting room all on Redis,
# which is the topology the rush is meant to exercise.
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
PULSE_INGEST_DRIVER=redis

# ADR-0049 §6: the first release deploys with SSR off, so the rig matches it
# and needs no `ssr` role.
INERTIA_SSR_ENABLED=false

# Off by default; the `migrate` service turns it on for its own one-shot run
# so no long-running role races the schema (ADR-0049 §3).
AUTO_MIGRATE=false

# ADR-0049 §8: nothing here is worth backing up, and the schedule would only
# compete with the rush for IO.
BACKUP_ENABLED=false

# ticket-rush.js gives every one of the 1,000 arrivals its own X-Forwarded-For
# address, because IssueWaitingRoomTicket::IP_CAP refuses a sixth new ticket
# from one source IP and every VU shares the k6 container's real one. The
# header is only honoured if the proxy sending it is trusted; inside this
# rig's own bridge network there is no untrusted hop to worry about.
TRUSTED_PROXIES=*

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=rig@konventix.test

REVERB_APP_PROVIDER=brands
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Empty, not absent. routes/channels.php calls Broadcast::channel() while the
# application boots, which constructs the Pusher client for the `reverb`
# connection before any brand is in play; Pusher's constructor is typed
# `string`, so an unset variable (env() -> null) is a fatal TypeError on every
# artisan command, while an empty one is merely the unused fallback the
# `brands` provider replaces per broadcast. .env.example ships them empty for
# exactly this reason.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
