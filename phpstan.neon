includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - app-modules/
        - bootstrap/app.php
        - bootstrap/providers.php
        - config/
        - database/
        - routes/

    # Test directories are deliberately out of scope — both the root tests/ and
    # each module's own tests/. Pest's higher-order `TestCall` chain is invisible
    # to PHPStan without pestphp/pest-plugin-phpstan, so scanning tests produces
    # only false positives. Add the plugin, then drop these exclusions.
    excludePaths:
        - app-modules/*/tests/*
        # Vendor code we publish rather than write. Horizon's and Pulse's
        # configs and Pulse's migration are copied verbatim from their
        # packages, and their loose `env()` handling and driver `match`
        # arms are upstream's to fix. Editing them here to satisfy level 7
        # would mean carrying a private diff through every package upgrade,
        # for files we do not own and do not change.
        - config/horizon.php
        - config/pulse.php
        - database/migrations/*_create_pulse_tables.php
        - database/migrations/*_create_health_tables.php

    level: 7

    ignoreErrors:
        # The block-composition validation trait (ROADMAP slice 21a) is
        # consumed by the admin block editor's CRUD, which does not exist
        # before Task 10; until then its only user is a test's anonymous
        # class, which PHPStan does not count. Drop this once a real Action
        # or controller uses it.
        -
            identifier: trait.unused
            path: app-modules/platform/src/Blocks/ValidatesBlockComposition.php
