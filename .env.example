APP_NAME=Konventix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the target database for every environment, local included.
# Hostnames are compose service names: the dev workflow runs everything
# through Sail (`sail artisan`, `sail test`), inside the compose network.
# Tests run against the separate "testing" database created by Sail's
# pgsql init script (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=konventix
DB_USERNAME=konventix
DB_PASSWORD=password
# DB_SSLMODE=prefer
# DB_SCHEMA=public

# The compose stack runs `migrate --force` in a one-shot service before any
# application role starts. Set to false to disable automatic migration and
# run migrations manually (`sail artisan migrate`).
AUTO_MIGRATE=true

# Platform Stripe credentials (ADR-0039). The restricted platform key acts
# on behalf of connected accounts; the signing secret verifies webhooks.
# Mollie/Unzer need no env entries — their keys are per-brand, stored
# encrypted on the settlement account.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Web push (ADR-0041): one VAPID key pair per deployment, generated with
# `php artisan messaging:vapid-keys`. Rotating the pair invalidates every
# stored browser subscription. VAPID_SUBJECT defaults to
# mailto:MAIL_FROM_ADDRESS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis backs cache, queues and sessions once the infrastructure is in place.
# Flip SESSION_DRIVER / QUEUE_CONNECTION / CACHE_STORE to "redis" then.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_PREFIX=

# Local mail lands in Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (ADR-0043). Each purpose points at its own disk; media
# defaults to local files served through the public/storage symlink. Set
# MEDIA_DISK=media_s3 to put NEW uploads on S3 — existing items keep the disk
# recorded on their row, and `storage:migrate` moves what already exists.
MEDIA_DISK=media
INVOICES_DISK=invoices

# Shared S3 credentials. The per-purpose AWS_MEDIA_* variables below fall back
# to these, so a single-bucket deployment only sets this block.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media-specific overrides — typically only the bucket and, when the bucket is
# publicly readable, the flag that lets URLs bypass the application entirely.
# AWS_MEDIA_PUBLIC_DIRECT says the operator made the bucket readable without
# credentials (a bucket policy on Hetzner, website mode on Garage); nothing is
# inferred from it being S3, and `storage:doctor` verifies the claim.
# AWS_MEDIA_BUCKET=
# AWS_MEDIA_URL=
# AWS_MEDIA_ENDPOINT=
# AWS_MEDIA_ACCESS_KEY_ID=
# AWS_MEDIA_SECRET_ACCESS_KEY=
# AWS_MEDIA_DEFAULT_REGION=
# AWS_MEDIA_USE_PATH_STYLE_ENDPOINT=
# AWS_MEDIA_PREFIX=media
# AWS_MEDIA_PUBLIC_DIRECT=false

# Invoice-archive overrides. Never public and never presigned — Commerce
# streams the archive through its own authenticated controller. Create the
# bucket with Object Lock where the provider supports it (Hetzner does, at
# creation time only; Garage implements neither Object Lock nor versioning).
# AWS_INVOICES_BUCKET=
# AWS_INVOICES_ENDPOINT=
# AWS_INVOICES_ACCESS_KEY_ID=
# AWS_INVOICES_SECRET_ACCESS_KEY=
# AWS_INVOICES_DEFAULT_REGION=
# AWS_INVOICES_USE_PATH_STYLE_ENDPOINT=
# AWS_INVOICES_PREFIX=invoices

# One shared Reverb server; one app entry per brand (ADR-0025). With
# REVERB_APP_PROVIDER=brands, apps come from brand rows (key/secret are
# provisioned on brand creation); the static credentials below only feed
# the fallback "config" driver.
# FORWARD_REVERB_PORT is the host-side port the browser connects to
# (dodges clashes with other local stacks on 8080).
REVERB_APP_PROVIDER=brands
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http
# Host-side port the browser connects to; the container listens on 8080.
FORWARD_REVERB_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${FORWARD_REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
