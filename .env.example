APP_NAME=Konventix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the target database for every environment, local included.
# Hostnames are compose service names: the dev workflow runs everything
# through Sail (`sail artisan`, `sail test`), inside the compose network.
# Tests run against the separate "testing" database created by Sail's
# pgsql init script (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=konventix
DB_USERNAME=konventix
DB_PASSWORD=password
# DB_SSLMODE=prefer
# DB_SCHEMA=public

# The compose stack runs `migrate --force` in a one-shot service before any
# application role starts. Set to false to disable automatic migration and
# run migrations manually (`sail artisan migrate`).
AUTO_MIGRATE=true

# Platform Stripe credentials (ADR-0039). The restricted platform key acts
# on behalf of connected accounts; the signing secret verifies webhooks.
# Mollie/Unzer need no env entries — their keys are per-brand, stored
# encrypted on the settlement account.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Web push (ADR-0041): one VAPID key pair per deployment, generated with
# `php artisan messaging:vapid-keys`. Rotating the pair invalidates every
# stored browser subscription. VAPID_SUBJECT defaults to
# mailto:MAIL_FROM_ADDRESS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Steam login (D-IDN-01 as amended: Steam is the only social driver). There is
# nothing to register — Steam is OpenID 2.0, so no client id and no secret.
# This key is the Steam *Web API* key and is optional: without it a Steam login
# still works and simply carries no display name or avatar, which onboarding
# asks for anyway. https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis backs cache, queues and sessions once the infrastructure is in place.
# Flip SESSION_DRIVER / QUEUE_CONNECTION / CACHE_STORE to "redis" then.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_PREFIX=

# Local mail lands in Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (ADR-0043). Each purpose points at its own disk; media
# defaults to local files served through the public/storage symlink. Set
# MEDIA_DISK=media_s3 to put NEW uploads on S3 — existing items keep the disk
# recorded on their row, and `storage:migrate` moves what already exists.
MEDIA_DISK=media
INVOICES_DISK=invoices
EXPORTS_DISK=exports

# Shared S3 credentials. The per-purpose AWS_MEDIA_* variables below fall back
# to these, so a single-bucket deployment only sets this block.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media-specific overrides — typically only the bucket and, when the bucket is
# publicly readable, the flag that lets URLs bypass the application entirely.
# AWS_MEDIA_PUBLIC_DIRECT says the operator made the bucket readable without
# credentials (a bucket policy on Hetzner, website mode on Garage); nothing is
# inferred from it being S3, and `storage:doctor` verifies the claim.
# AWS_MEDIA_BUCKET=
# AWS_MEDIA_URL=
# AWS_MEDIA_ENDPOINT=
# AWS_MEDIA_ACCESS_KEY_ID=
# AWS_MEDIA_SECRET_ACCESS_KEY=
# AWS_MEDIA_DEFAULT_REGION=
# AWS_MEDIA_USE_PATH_STYLE_ENDPOINT=
# AWS_MEDIA_PREFIX=media
# AWS_MEDIA_PUBLIC_DIRECT=false

# Invoice-archive overrides. Never public and never presigned — Commerce
# streams the archive through its own authenticated controller. Create the
# bucket with Object Lock where the provider supports it (Hetzner does, at
# creation time only; Garage implements neither Object Lock nor versioning).
# AWS_INVOICES_BUCKET=
# AWS_INVOICES_ENDPOINT=
# AWS_INVOICES_ACCESS_KEY_ID=
# AWS_INVOICES_SECRET_ACCESS_KEY=
# AWS_INVOICES_DEFAULT_REGION=
# AWS_INVOICES_USE_PATH_STYLE_ENDPOINT=
# AWS_INVOICES_PREFIX=invoices

# Developing against object storage: bring the stack up with the `s3` profile
# (COMPOSE_PROFILES=s3 below, or `sail --profile s3 up -d`), then run
# `sail artisan storage:garage-init` once and `sail artisan storage:doctor` to
# check it. Garage creates the layout, the key and the first bucket at boot;
# the init command adds the second bucket and the website access that makes
# the public one anonymously readable — Garage has no bucket policies or ACLs.
# COMPOSE_PROFILES=s3
# GARAGE_ADMIN_ENDPOINT=http://garage:3903
# GARAGE_ADMIN_TOKEN=konventix-dev-admin-token
#
# The matching disk configuration for that stack (dev credentials — the same
# ones compose.yaml hands Garage):
# MEDIA_DISK=media_s3
# INVOICES_DISK=invoices_s3
# EXPORTS_DISK=exports_s3
# AWS_ACCESS_KEY_ID=GKkonventixdevaccesskey00000000
# AWS_SECRET_ACCESS_KEY=konventixdevsecretkey0000000000000000000000000000000000000000000
# AWS_DEFAULT_REGION=garage
# AWS_ENDPOINT=http://garage:3900
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_MEDIA_BUCKET=konventix-public
# AWS_INVOICES_BUCKET=konventix-private
# AWS_EXPORTS_BUCKET=konventix-private
# AWS_MEDIA_PUBLIC_DIRECT=true
# Garage serves anonymous reads on its web endpoint, not the S3 API, and picks
# the bucket from the Host header. The `.localhost` form is what a browser
# needs (it resolves to loopback, and compose publishes 3902):
# AWS_MEDIA_URL=http://konventix-public.web.garage.localhost:3902
#
# Note for `storage:doctor`: a `.localhost` name never leaves the container
# that asks for it, so the anonymous-fetch check reports "could not be
# verified" in the dev stack. Verify it from your host instead:
#   curl http://konventix-public.web.garage.localhost:3902/media/<key>
# In production the asset host is a real name and the check runs for real.

# One shared Reverb server; one app entry per brand (ADR-0025). With
# REVERB_APP_PROVIDER=brands, apps come from brand rows (key/secret are
# provisioned on brand creation); the static credentials below only feed
# the fallback "config" driver.
# FORWARD_REVERB_PORT is the host-side port the browser connects to
# (dodges clashes with other local stacks on 8080).
REVERB_APP_PROVIDER=brands
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http
# Host-side port the browser connects to; the container listens on 8080.
FORWARD_REVERB_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${FORWARD_REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
