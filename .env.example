APP_NAME=Konventix
# Shown in the page footer; set from a tag or commit at deploy time.
APP_VERSION=dev
# Anything but "production" is a non-production instance (ADR-0053): strict
# models, the corner ribbon on every page, mail held back to MAIL_ALLOWLIST.
# A missing APP_ENV counts as non-production too — loud by default.
APP_ENV=local
# The ribbon's label defaults to the environment name, its color to the
# danger token; ENVIRONMENT_RIBBON=true|false forces it either way.
# ENVIRONMENT_RIBBON_LABEL=
# ENVIRONMENT_RIBBON_COLOR=
# APP_KEY encrypts per-brand mail credentials (ADR-0028), PSP keys (ADR-0046)
# and Reverb secrets at rest. Generate it once; it lives in the deployment's
# secret store and MUST stay stable for the life of the database — losing it
# orphans every encrypted row. Rotation (ADR-0049 §12): move the old key into
# APP_PREVIOUS_KEYS (comma-separated), set the new APP_KEY, deploy — Laravel
# decrypts with previous keys and encrypts with the current one.
# APP_PREVIOUS_KEYS=
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Konventix runs behind a reverse proxy that terminates TLS (out of scope for
# this application). These are the addresses whose X-Forwarded-* headers are
# believed — including X-Forwarded-Host, which is how the visitor's real host
# reaches brand resolution. Comma-separated; CIDR allowed.
#
# Defaults to loopback plus the RFC 1918 ranges, which covers a container
# network or a co-located proxy. Use `*` ONLY where nothing can reach the app
# except through the proxy: trusting every client's X-Forwarded-Host lets a
# direct caller pick which brand it is talking to.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Inertia SSR (ADR-0049 §6). On by default for dev; a deployment with no SSR
# process sets false. INERTIA_SSR_URL points the web role at the ssr role.
# INERTIA_SSR_ENABLED=true
# INERTIA_SSR_URL=http://127.0.0.1:13714

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the target database for every environment, local included.
# Hostnames are compose service names: the dev workflow runs everything
# through Sail (`sail artisan`, `sail test`), inside the compose network.
# Tests run against the separate "testing" database created by Sail's
# pgsql init script (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=konventix
DB_USERNAME=konventix
DB_PASSWORD=password
# DB_SSLMODE=prefer
# DB_SCHEMA=public

# The compose stack runs `migrate --force` in a one-shot service before any
# application role starts. Set to false to disable automatic migration and
# run migrations manually (`sail artisan migrate`).
AUTO_MIGRATE=true

# This instance's own Stripe account (ADR-0058): one Stripe account per
# instance, the operator's — the key charges and refunds on it directly, the
# signing secret verifies its webhooks. Entering the pair in the operator
# console instead stores it encrypted and takes precedence over these.
# Mollie/Unzer need no env entries — their keys are per-brand, stored
# encrypted on the settlement account.
# Local dev: `./contrib/stripe-listen.sh` forwards real Stripe events here and prints the
# webhook signing secret to paste into STRIPE_WEBHOOK_SECRET below (README, "Stripe webhooks
# in local development").
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Web push (ADR-0041): one VAPID key pair per deployment, generated with
# `php artisan messaging:vapid-keys`. Rotating the pair invalidates every
# stored browser subscription. VAPID_SUBJECT defaults to
# mailto:MAIL_FROM_ADDRESS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Steam login (D-IDN-01 as amended: Steam is the only social driver). There is
# nothing to register — Steam is OpenID 2.0, so no client id and no secret.
# This key is the Steam *Web API* key and is optional: without it a Steam login
# still works and simply carries no display name or avatar, which onboarding
# asks for anyway. https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=
# Redis, not database: Horizon supervises Redis queues and nothing else, so
# this is the connection the queue dashboard reads. The `database` driver still
# works if Horizon is removed — flip this back and run `queue:work` instead.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Pulse writes an entry per slow query, job and request. Sending them through a
# Redis stream keeps those writes out of the request that caused them; a
# `pulse:work` process drains the stream into the database.
PULSE_INGEST_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# Commerce's waiting room (ADR-0047 point 5) — its own database, so a
# cache flush never drops an active queue and vice versa.
REDIS_WAITING_ROOM_DB=2
# REDIS_PREFIX=

# The waiting room's store (config/commerce.php). `redis` in every real
# environment; `array` is what phpunit.xml sets for the test suite — an
# in-memory stand-in, never bind it in production.
# WAITING_ROOM_STORE=redis

# Exception reporting. Empty means Sentry is installed but sends nothing, which
# is the correct state for development and CI. Before setting a DSN in
# production, decide the data-protection question it raises: an exception
# report carries request context from an application that handles
# registrations, invoices and subject requests, so either a self-hosted
# instance or a data-processing agreement applies. `send_default_pii` stays
# false regardless — turning it on attaches user identifiers to every event.
SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Backups. The destination MUST NOT be the same storage the application writes
# to: a bucket is not a backup of itself. `local` is a placeholder for
# development; production points this at an off-site disk.
BACKUP_DESTINATION_DISK=local
BACKUP_NOTIFICATION_EMAIL=
# ADR-0049 §8: BACKUP_ENABLED=false skips the backup schedule entirely (the
# cluster's database operator owns backups); BACKUP_INCLUDE_DATABASE=false
# keeps file backups but drops the pg_dump.
# BACKUP_ENABLED=true
# BACKUP_INCLUDE_DATABASE=true

# Deeper health checks than `/up`, for an external monitor. Unset means the
# JSON endpoint is not registered at all — an unauthenticated report of which
# of your services are failing is a reconnaissance gift.
HEALTH_ENDPOINT_SECRET=
# ADR-0049 §11: the disk check measures / by default — ephemeral in a
# cluster. Point it at the data volume, or disable it there.
# HEALTH_DISK_CHECK=true
# HEALTH_DISK_CHECK_PATH=/var/www/html/storage

# Local mail lands in Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Off production, mail only reaches these recipients (comma separated: full
# addresses, @domain suffixes, or * when a mailcatcher sits behind the
# mailer). Empty means nothing leaves. Mailpit catches everything here.
MAIL_ALLOWLIST="*"
# Subjects carry "[<environment>]" off production; false to switch that off.
# MAIL_TAG_SUBJECTS=true

# Object storage (ADR-0043). Each purpose points at its own disk; media
# defaults to local files served through the public/storage symlink. Set
# MEDIA_DISK=media_s3 to put NEW uploads on S3 — existing items keep the disk
# recorded on their row, and `storage:migrate` moves what already exists.
MEDIA_DISK=media
INVOICES_DISK=invoices
EXPORTS_DISK=exports

# Shared S3 credentials. The per-purpose AWS_MEDIA_* variables below fall back
# to these, so a single-bucket deployment only sets this block.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media-specific overrides — typically only the bucket and, when the bucket is
# publicly readable, the flag that lets URLs bypass the application entirely.
# AWS_MEDIA_PUBLIC_DIRECT says the operator made the bucket readable without
# credentials (a bucket policy on Hetzner, website mode on Garage); nothing is
# inferred from it being S3, and `storage:doctor` verifies the claim.
# AWS_MEDIA_BUCKET=
# AWS_MEDIA_URL=
# AWS_MEDIA_ENDPOINT=
# AWS_MEDIA_ACCESS_KEY_ID=
# AWS_MEDIA_SECRET_ACCESS_KEY=
# AWS_MEDIA_DEFAULT_REGION=
# AWS_MEDIA_USE_PATH_STYLE_ENDPOINT=
# AWS_MEDIA_PREFIX=media
# AWS_MEDIA_PUBLIC_DIRECT=false

# Invoice-archive overrides. Never public and never presigned — Commerce
# streams the archive through its own authenticated controller. Create the
# bucket with Object Lock where the provider supports it (Hetzner does, at
# creation time only; Garage implements neither Object Lock nor versioning).
# AWS_INVOICES_BUCKET=
# AWS_INVOICES_ENDPOINT=
# AWS_INVOICES_ACCESS_KEY_ID=
# AWS_INVOICES_SECRET_ACCESS_KEY=
# AWS_INVOICES_DEFAULT_REGION=
# AWS_INVOICES_USE_PATH_STYLE_ENDPOINT=
# AWS_INVOICES_PREFIX=invoices

# Developing against object storage: the `garage` container is part of the
# stack and comes up with every `sail up` (compose.yaml carries no profiles —
# `vendor/bin/sail` has no `--profile` support, so COMPOSE_PROFILES gated a
# service the project's own command could not reach). Garage running is not
# the same as the app using it: that is the disk configuration below.
#
# Run `sail artisan storage:garage-init` once and `sail artisan storage:doctor`
# to check it. Garage creates the layout, the key and the first bucket at boot;
# the init command adds the second bucket and the website access that makes
# the public one anonymously readable — Garage has no bucket policies or ACLs.
# GARAGE_ADMIN_ENDPOINT=http://garage:3903
# GARAGE_ADMIN_TOKEN=konventix-dev-admin-token
#
# The matching disk configuration for that stack (dev credentials — the same
# ones compose.yaml hands Garage):
# MEDIA_DISK=media_s3
# INVOICES_DISK=invoices_s3
# EXPORTS_DISK=exports_s3
# AWS_ACCESS_KEY_ID=GKkonventixdevaccesskey00000000
# AWS_SECRET_ACCESS_KEY=konventixdevsecretkey0000000000000000000000000000000000000000000
# AWS_DEFAULT_REGION=garage
# AWS_ENDPOINT=http://garage:3900
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_MEDIA_BUCKET=konventix-public
# AWS_INVOICES_BUCKET=konventix-private
# AWS_EXPORTS_BUCKET=konventix-private
# AWS_MEDIA_PUBLIC_DIRECT=true
# Garage serves anonymous reads on its web endpoint, not the S3 API, and picks
# the bucket from the Host header. The `.localhost` form is what a browser
# needs (it resolves to loopback, and compose publishes 3902):
# AWS_MEDIA_URL=http://konventix-public.web.garage.localhost:3902
#
# Note for `storage:doctor`: a `.localhost` name never leaves the container
# that asks for it, so the anonymous-fetch check reports "could not be
# verified" in the dev stack. Verify it from your host instead:
#   curl http://konventix-public.web.garage.localhost:3902/media/<key>
# In production the asset host is a real name and the check runs for real.

# One shared Reverb server; one app entry per brand (ADR-0025). With
# REVERB_APP_PROVIDER=brands, apps come from brand rows (key/secret are
# provisioned on brand creation); the static credentials below only feed
# the fallback "config" driver.
# FORWARD_REVERB_PORT is the host-side port the browser connects to
# (dodges clashes with other local stacks on 8080).
# In production the browser derives the endpoint from the page and uses the
# fixed /ws path (ADR-0049 §5): set REVERB_SERVER_PATH=/ws there and route
# /ws on every brand host (and the admin host) to the Reverb service. The
# prefix moves Reverb's whole route set, so the backend publish API the
# application broadcasts through and Reverb's own /up probe move under it
# too (/ws/apps/..., /ws/up). Dev connects directly and leaves it empty.
# REVERB_SERVER_PATH=
REVERB_APP_PROVIDER=brands
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http
# Host-side port the browser connects to; the container listens on 8080.
FORWARD_REVERB_PORT=8080

# The k6 load test and its dashboard (ADR-0047 point 6, ROADMAP slice 24).
# Grafana is provisioned from contrib/grafana and opens straight on the
# "Ticket rush (k6)" board; Prometheus is only the sink k6 pushes into and is
# published mainly so you can check a query by hand. Both host ports dodge
# their upstream defaults' usual clashes, the same way FORWARD_REVERB_PORT
# does — inside the compose network the services stay on 3000 and 9090.
#
#   sail up -d
#   sail artisan konventix:seed --rush
#   docker compose run --rm k6 run /scripts/ticket-rush.js
#
# Set K6_OUT= (empty) on that run to skip the dashboard and get stdout only.
FORWARD_GRAFANA_PORT=3000
FORWARD_PROMETHEUS_PORT=9091

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${FORWARD_REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
