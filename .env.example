APP_NAME=Konventix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the target database for every environment, local included.
# Hostnames are compose service names: the dev workflow runs everything
# through Sail (`sail artisan`, `sail test`), inside the compose network.
# Tests run against the separate "testing" database created by Sail's
# pgsql init script (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=konventix
DB_USERNAME=konventix
DB_PASSWORD=password
# DB_SSLMODE=prefer
# DB_SCHEMA=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis backs cache, queues and sessions once the infrastructure is in place.
# Flip SESSION_DRIVER / QUEUE_CONNECTION / CACHE_STORE to "redis" then.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_PREFIX=

# Local mail lands in Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# One shared Reverb server; one app entry per brand (ADR-0025). With
# REVERB_APP_PROVIDER=brands, apps come from brand rows (key/secret are
# provisioned on brand creation); the static credentials below only feed
# the fallback "config" driver.
# FORWARD_REVERB_PORT is the host-side port the browser connects to
# (dodges clashes with other local stacks on 8080).
REVERB_APP_PROVIDER=brands
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http
# Host-side port the browser connects to; the container listens on 8080.
FORWARD_REVERB_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${FORWARD_REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
